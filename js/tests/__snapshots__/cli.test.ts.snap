"import type { Context, Next } from "matrix-bot-kit";

export const loggerMiddleware = async (ctx: Context, next: Next) => {
	console.log(\`[Middleware] Received command: \${ctx.message.body}\`);
	await next();
};
"
`;

exports[`CLI Tests Template Generation Snapshots getModuleTs 1`] = `
"import { type MatrixBot } from "matrix-bot-kit";

export function exampleModule(bot: MatrixBot) {
	// Commands are attached directly to the bot
	bot.command("!example", async (ctx) => {
		await ctx.reply.text("Hello from example module!");
	});

	// Background tasks use our new clean schedule options
	bot.on.schedule({ everyDay: 1 }, async (event) => {
		// This runs automatically once every day!
		// console.log("Scheduled task ran!", event);
	});
}
"
`;

